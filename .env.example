# StansiaReco Environment Configuration

# Application Environment (development, staging, production)
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Database Configuration (PostgreSQL 17)
POSTGRES_DB=stansiareco
POSTGRES_USER=stansiareco
POSTGRES_PASSWORD=Assanimed1420
DATABASE_URL=postgres://stansiareco:Assanimed1420@localhost:5432/stansiareco?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_MAX_IDLE_TIME=15m
DB_MAX_CONN_LIFETIME=1h

# Master Secret Encryption Key (Must be 32 bytes hex encoded - 64 hex characters)
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=6a739b2247560c62596a9cfec910d4b01223bc6ac21463de1ff53fcd8ea7669c
APP_ENCRYPTION_KEY_ID=1

# Session Management
# In production, must be at least 32 characters
SESSION_SECRET=super-secret-development-session-key-change-in-prod
SESSION_TTL=24h

# Security & Outbound Dial Policies (SSRF Prevention)
# When set to false, blocks dialing private RFC 1918 and loopback IPs
OUTBOUND_ALLOW_PRIVATE_IPS=false

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Next.js Public API Base
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
